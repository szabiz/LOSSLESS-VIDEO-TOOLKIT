    {
     "name": "type",
     "type": "int",
     "default": 1,
     "label": [
      "Típus",
      "Type"
     ],
     "basic": false,
     "choices": [
      0,
      1
     ]
    },
    {
     "name": "chroma",
     "type": "int",
     "default": 0,
     "label": [
      "Szín is",
      "Include chroma"
     ],
     "basic": false,
     "choices": [
      0,
      1
     ]
    }
   ]
  },
  {

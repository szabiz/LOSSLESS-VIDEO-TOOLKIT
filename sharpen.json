{
 "filters": [
  {
   "ns": "cas",
   "fn": "CAS",
   "cat": "line",
   "label": [
    "Adaptív élesítés (CAS)",
    "Adaptive sharpen (CAS)"
   ],
   "help": [
    "Kontraszt-adaptív élesítés: kevés artefaktummal élesít.",
    "Contrast-adaptive sharpening: sharpens with few artifacts."
   ],
   "params": [
    {
     "name": "sharpness",
     "type": "float",
     "default": 0.5,
     "label": [
      "Élesség",
      "Sharpness"
     ],
     "basic": true,
     "min": 0,
     "max": 1,
     "step": 0.05
    },
    {
     "name": "planes",
     "type": "expr",
     "default": "[0, 1, 2]",
     "label": [
      "Síkok",
      "Planes"
     ],
     "basic": false,
     "help": [
      "Mely síkokra hat: [0] = csak fény (Y), [0, 1, 2] = mind.",
      "Planes to process: [0] = luma only, [0, 1, 2] = all."
     ]
    }
   ],
   "presets": [
    {
     "name": [
      "Gyenge",
      "Light"
     ],
     "values": {
      "sharpness": 0.3
     }
    },
    {
     "name": [
      "Közepes",
      "Medium"
     ],
     "values": {
      "sharpness": 0.5
     }
    },
    {
     "name": [
      "Erős",
      "Strong"
     ],
     "values": {
      "sharpness": 0.8
     }
    }
   ]
  },
  {
